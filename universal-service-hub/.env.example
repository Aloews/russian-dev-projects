# Local development only. scripts/dev-up.sh generates strong values automatically.
USH_API_TOKEN=
USH_DB_PASSWORD=
USH_APP_DB_PASSWORD=
USH_RATE_LIMIT_PER_MINUTE=120
PORT=8000

# Trusted GitHub Actions evidence ingestion; keep empty until the reusable workflow is pinned.
USH_GITHUB_OIDC_AUDIENCE=
USH_GITHUB_ALLOWED_WORKFLOW_REFS=
USH_GITHUB_ALLOWED_JOB_WORKFLOW_REFS=
USH_GITHUB_ALLOWED_SOURCE_WORKFLOW_PATHS=
USH_GITHUB_TRUSTED_JOB_WORKFLOW_SHA=
# Optional: GitHub token with Actions read access for private repositories / higher API limits.
USH_GITHUB_API_TOKEN=
